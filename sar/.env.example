# Copy to `.env` (which is git-ignored) and fill in. NEVER commit real keys.
# Names below are the ones referenced by configs/*.yaml; only variables used by your chosen
# provider/store are required.

# Vector store (default persistent store, methodology Table 6.1)
PINECONE_API_KEY=

# LLM provider (choose one via llm.provider in the config)
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # optional OpenAI-compatible endpoint (upstream MIGRES uses a custom base_url)

# Exact model id to call. Deliberately has NO default: use a model your provider actually offers.
LLM_MODEL=

# Path to a local clone of https://github.com/AdelWang/MIGRES  (not bundled)
MIGRES_REPO_DIR=
